<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="16dp">

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="44sp"
        android:gravity="end"
        android:layout_marginBottom="24dp"
        android:padding="16dp"
        android:maxLines="2"/>

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn_c" android:text="C" android:backgroundTint="#EF5350" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_open" android:text="(" android:backgroundTint="#37474F" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_close" android:text=")" android:backgroundTint="#37474F" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_div" android:text="÷" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="24sp"/>
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn_7" android:text="7" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_8" android:text="8" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_9" android:text="9" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_mult" android:text="×" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="24sp"/>
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn_4" android:text="4" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_5" android:text="5" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_6" android:text="6" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_sub" android:text="-" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="24sp"/>
        </TableRow>

        <TableRow android:layout_marginBottom="8dp">
            <Button android:id="@+id/btn_1" android:text="1" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_2" android:text="2" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_3" android:text="3" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_add" android:text="+" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="24sp"/>
        </TableRow>

        <TableRow>
            <Button android:id="@+id/btn_0" android:text="0" android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:layout_span="2" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_dot" android:text="." android:backgroundTint="#263238" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="20sp"/>
            <Button android:id="@+id/btn_equal" android:text="=" android:backgroundTint="#FF9800" android:textColor="#FFFFFF" android:layout_margin="4dp" android:width="70dp" android:height="70dp" android:textSize="24sp"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
